# MCP Server port (exposed on host, read by the HTTP server)
PLANKA_MCP_PORT=3008

# Bearer token required to call the HTTP (streamable-http) endpoint.
# REQUIRED for the HTTP server: if unset, /mcp is disabled and rejects every
# request. Clients must send: Authorization: Bearer <this value>.
# Generate one with e.g.: openssl rand -hex 32
PLANKA_MCP_TOKEN=

# Planka instance connection
PLANKA_BASE_URL=http://localhost:3000
PLANKA_AGENT_EMAIL=demo@demo.demo
PLANKA_AGENT_PASSWORD=demo

# Admin lookup (pick one)
PLANKA_ADMIN_ID=
PLANKA_ADMIN_EMAIL=
PLANKA_ADMIN_USERNAME=